@model CrudMvcApp.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h1>Product Details</h1>
<div class="card p-4">
    <h4>Product</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>
        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Model.Price</dd>
        <dt class="col-sm-2">Quantity</dt>
        <dd class="col-sm-10">@Model.Quantity</dd>
        <dt class="col-sm-2">Category</dt>
        <dd class="col-sm-10">@Model.Category</dd>
        <dt class="col-sm-2">Image</dt>
        <dd class="col-sm-10"><img src="@Model.ImageUrl" alt="Image" width="100" /></dd>
        <dt class="col-sm-2">Created At</dt>
        <dd class="col-sm-10">@Model.CreatedAt.ToString("g")</dd>
        <dt class="col-sm-2">Updated At</dt>
        <dd class="col-sm-10">@Model.UpdatedAt?.ToString("g")</dd>
        <dt class="col-sm-2">Updated By</dt>
        <dd class="col-sm-10">@Model.UpdatedBy</dd>
        <dt class="col-sm-2">Deleted</dt>
        <dd class="col-sm-10">@(Model.Deleted ? "Yes" : "No")</dd>
    </dl>
    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
    </div>
</div> 