@model IEnumerable<CrudMvcApp.Models.Product>

@{
    ViewData["Title"] = "Product List";
}

<h1>Product List</h1>
<div class="card p-4">
    <p>
        <a asp-action="Create" class="btn btn-primary mb-3">Create New Product</a>
    </p>
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Category</th>
                    <th>Image</th>
                    <th>Created At</th>
                    <th>Updated By</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.Price</td>
                    <td>@item.Quantity</td>
                    <td>@item.Category</td>
                    <td><img src="@item.ImageUrl" alt="Image" width="50" /></td>
                    <td>@item.CreatedAt.ToString("g")</td>
                    <td>@item.UpdatedBy</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary mx-1">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div> 